# Скопируйте в .env и впишите свои значения. Сам .env в git не попадает.
# Kie.ai — первый голос в цепочке озвучки (https://kie.ai/api-key)
KIE_API_KEY=
# Модель: elevenlabs/text-to-speech-multilingual-v2 (по умолчанию) или elevenlabs/text-to-speech-turbo-2-5
KIE_TTS_MODEL=
# Запасной ElevenLabs напрямую
ELEVENLABS_API_KEY=
# Порядок озвучки, по умолчанию kie,edge,elevenlabs,offline
LESSON_TTS_CHAIN=
